# Copy to .env.local and fill. .env* files are gitignored and must never be committed.

# Postgres. The connecting role must be able to `SET ROLE isaac_app` (the migration grants it).
DATABASE_URL=postgres://postgres@localhost:5432/isaac_dev
# On Supabase use the Transaction pooler string (port 6543) and end it with ?sslmode=no-verify. See docs/DEPLOY.md.
# At least 32 random characters. Signs the login cookie.
SESSION_SECRET=
# Public URL of the app. Used for OAuth redirects and links inside reminder emails.
# In production: https only, no trailing slash. A wrong value breaks Google sign-in and every link in the emails.
APP_URL=http://localhost:3000
# Comma-separated Google accounts allowed to sign in. Empty = nobody (fails closed).
ALLOWED_EMAILS=

# Google OAuth (console.cloud.google.com → Credentials → OAuth client, type "Web application").
# Authorised redirect URI: ${APP_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts the stored Gmail refresh token.
TOKEN_ENC_KEY=

# Resend (reminder emails to Isaac). RESEND_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=
# At least 16 random chars. The hourly scheduler calls /api/cron/reminders with `Authorization: Bearer <this>`.
CRON_SECRET=

# Local development only: `1` enables /api/dev-login (skips Google). Ignored when NODE_ENV=production.
DEV_LOGIN=
